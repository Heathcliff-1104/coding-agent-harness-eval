+        Long cnt = rolePermissionMapper.selectCount(new LambdaQueryWrapper<RolePermission>().eq(RolePermission::getRoleId, role.getId()));
+        if (cnt != null && cnt > 0) {
+            return; // 已有映射，不覆盖管理员配置
+        }
+        List<Permission> perms;

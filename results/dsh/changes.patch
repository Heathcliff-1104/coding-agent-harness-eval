+# H2 内存数据库（MySQL兼容模式），用于自动化测试，无需本机MySQL
+spring.datasource.driver-class-name=org.h2.Driver
+spring.datasource.url=jdbc:h2:mem:bms;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
+spring.datasource.username=sa
+spring.datasource.password=
+
+# 使用H2专用schema（多个测试类共享同一内存库，重复初始化时忽略已存在数据）
+spring.sql.init.mode=always
+spring.sql.init.schema-locations=classpath:schema-h2.sql
+spring.sql.init.continue-on-error=true
+
+mybatis-plus.configuration.map-underscore-to-camel-case=true
+logging.level.com.koolearn.bms=INFO
+
+# 演示模式（不调用真实钉钉/CIS）
+dingtalk.mock.enabled=true
+cis.endpoint=

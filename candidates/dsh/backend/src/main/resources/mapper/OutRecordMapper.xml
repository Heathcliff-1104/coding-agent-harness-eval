<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.koolearn.bms.mapper.OutRecordMapper">
    <select id="selectByDate" resultType="com.koolearn.bms.entity.OutRecord">
        select * from tb_out_record where out_time between #{start} and #{end}
    </select>
</mapper>